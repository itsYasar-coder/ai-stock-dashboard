# Copy this file to `.env` and fill in your values. Never commit the real .env.
#
# Alternative: put the same values in .streamlit/secrets.toml (same format as
# Streamlit Community Cloud's "Secrets" settings) — either location works locally.

# --- AI insights (any OpenAI-compatible API) ---
# Plain OpenAI: just set the key below.
# Gateways (ZCode/GLM etc.): also uncomment and set OPENAI_BASE_URL (include /v1).
OPENAI_API_KEY=sk-your-key-here
# OPENAI_BASE_URL=https://your-gateway.example.com/v1
# Optional model override (default: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

# --- App ---
LOG_LEVEL=INFO
